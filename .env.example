# ====================================================================
# FlashStat — Football Scores & AI Betting Radar Environment Config
# ====================================================================
# NOTE: The application works 100% out of the box in DEMO MODE without any API keys.
# To connect to live live-score feeds and odds feeds, supply the keys below.

# 1. API-Football (v3.football.api-sports.io)
# Free plan: ~100 requests/day, 10 req/min
# Leave empty or omit to run with automatic ESPN & local data fallbacks
API_FOOTBALL_KEY=your_api_football_key_here

# 2. Football-Data.org Key (Optional European fixtures provider)
FOOTBALL_DATA_KEY=your_football_data_key_here

# 3. Odds Provider API Key (e.g. The Odds API or API-Football Odds)
# Leave empty to use fallback standard odds & closing odds
ODDS_API_KEY=your_odds_api_key_here

# 4. Optional Betfair Exchange API (for margin-free exchange probability calculation)
BETFAIR_APP_KEY=your_betfair_app_key_here
BETFAIR_SESSION_TOKEN=your_betfair_session_token_here

# 5. VIP Authentication & Gatekeeper
VIP_USERNAME=admin
VIP_PASSWORD=your_secure_vip_password_here
VIP_AUTH_SECRET=your_32_char_hex_random_secret_here

# 6. Environment & Next.js settings
NODE_ENV=development

# 7. OpenTelemetry tracing (optional)
# Start a local OTLP collector, then set this to export request traces.
# Foundry Toolkit trace viewer uses: http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=flashstat-football-radar